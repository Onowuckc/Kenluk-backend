# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/kenluk

# JWT Configuration
JWT_ACCESS_SECRET=your_super_secret_access_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# 2FA Configuration
# Use a long random secret in production. If omitted, JWT secrets are used as fallback.
TWO_FACTOR_SECRET_KEY=your_long_random_2fa_encryption_key_here

# Client Configuration
CLIENT_URL=http://localhost:3000

# Email Configuration (Mailtrap)
MAILTRAP_HOST=send.api.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USER=api
MAILTRAP_PASS=your_mailtrap_password
MAIL_FROM=noreply@kenluk.com
MAIL_FROM_NAME=Kenluk Payments
CONTACT_TO_EMAIL=Info@kenluk.com

# Reap Payments API
REAP_PAYMENT_API_URL=https://payments.reap.global/api/payments
REAP_PAYMENT_API_KEY=your_reap_api_key_here
REAP_ENTITY_ID=your_reap_entity_id_here

# Reap Webhook — set this to the public URL of THIS backend server.
# Used by the auto-subscribe utility to register your webhook URL with Reap.
# Railway example: https://kenluk-backend-production.up.railway.app
BACKEND_URL=https://kenluk-backend-production.up.railway.app

# Optional: override with Reap Sandbox public key when NODE_ENV != production
# REAP_PUBLIC_KEY_SANDBOX=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
